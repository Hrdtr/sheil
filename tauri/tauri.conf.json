{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sheil",
  "version": "0.1.0",
  "identifier": "dev.hrdtr.sheil",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sheil",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 24,
          "y": 30
        },
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
